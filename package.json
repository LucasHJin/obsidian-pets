{
	"name": "pixel-pets",
	"version": "1.6.0",
	"description": "Adds cute and interactive pixel pets.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [],
	"author": "Lucas Jin",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"@types/node": "^16.11.6",
		"esbuild": "^0.17.3",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "1.14.4",
		"prettier": "3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.71.1"
	}
}
