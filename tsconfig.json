{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2018",
		"strict": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"lib": ["DOM", "ES2018"],
		"types": []
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
